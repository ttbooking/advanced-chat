includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - config
        - database/factories
        - database/seeders
        - routes
        - src
        - tests
        - workbench

    configDirectories:
        - config

    level: 2

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            reportUnmatched: false
        -
            message: '#^Class App\\Models\\User not found\.$#'
            path: config/advanced-chat.php
            reportUnmatched: false
        -
            message: '#^Method TTBooking\\AdvancedChat\\Models\\\w+::\w+\(\) invoked with \d+ parameters, \d+\-\d+ required\.$#'
            identifier: arguments.count
            path: src/Models/*.php
            reportUnmatched: false
